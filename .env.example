# .env  Description

# Comma-separated list of allowed development domains
ALLOWED_DEV_ORIGINS="http://localhost:3000,127.0.0.1:3000"

# Database connection string (replace with your actual provider credentials)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Base website url
BASE_URL="http://localhost:3000"

# Discord OAuth application ID
DISCORD_CLIENT_ID=""
# Discord OAuth application secret
DISCORD_CLIENT_SECRET=""

# Better auth secret
BETTER_AUTH_SECRET=""

# YooKassa payment gateway shop ID
YOO_KASSA_SHOP_ID=""
# YooKassa API key for payment processing
YOO_KASSA_SECRET_KEY=""

# Secret key for DCD integration
DCD_SECRET=""
# Host URL for DCD service
DCD_HOST=""
# Allowed discord ids (Panel) comma separated
ALLOWED_DISCORD_IDS=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# **Setup:** Copy this file to `.env` and fill in your actual values.