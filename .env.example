# Allowed origins for local development (CORS whitelist).
# Multiple values should be separated by commas.
ALLOWED_DEV_ORIGINS="http://localhost:3000,127.0.0.1:3000"

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Public base URL of the application (used for redirects, callbacks, etc.)
BASE_URL="http://localhost:3000"

# Discord OAuth credentials (from Discord Developer Portal)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Secret key used by the authentication system (must be secure and random)
BETTER_AUTH_SECRET=""

# Stripe secret API key 
STRIPE_SECRET_KEY=""      # (used for server-side payment processing)
STRIPE_WEBHOOK_SECRET=""  # (used to verify webhook signatures)

# DCD service integration settings
DCD_SECRET=""             # Shared secret for request validation
DCD_HOST=""               # Base URL of the DCD service

# Comma-separated list of Discord user IDs allowed to access the admin panel
ALLOWED_DISCORD_IDS=""

# Cloudinary configuration (media storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Setup:
# Copy this file to `.env` and replace all placeholder values with real credentials.